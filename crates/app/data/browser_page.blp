using Gtk 4.0;
using Adw 1;

// All Cards: search, filters and the list of every card, with actions on
// several cards at once (ADR 0036, 0044). The texts that change are set in
// pages/browser_page.rs (from browser_page/text.rs); deck and tag names
// (untrusted) only ever reach plain-text widgets.
template $RappelBrowserPage: Adw.NavigationPage {
  title: _("All Cards");

  // The bin's size request is the window's minimum (data/window.blp), as
  // on the deck page.
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    // A phone: no card count beside the filters (they need the width),
    // fewer pills in the rows, Select All and the action buttons without
    // their words (the page's `compact`, which they follow).
    Adw.Breakpoint breakpoint {
      condition ("max-width: 500sp")

      setters {
        count_label.visible: false;
      }
    }

    child: Adw.ToolbarView {
      // The search field as the title. While cards are being chosen the
      // shared header of selection mode takes its place (ui/selection.rs).
      [top]
      Adw.HeaderBar header {
        title-widget: Adw.Clamp {
          maximum-size: 400;
          tightening-threshold: 300;

          child: Gtk.SearchEntry search_entry {
            placeholder-text: _("Search cards");
            search-delay: 150;
            hexpand: true;

            accessibility {
              label: _("Search cards");
            }
          };
        };

        [end]
        Gtk.Button select_button {
          icon-name: "selection-mode-symbolic";
          action-name: "selection.choose";
          tooltip-text: _("Select Cards");

          accessibility {
            label: _("Select Cards");
          }
        }

        // While the tag filter names a tag: a session over the cards that
        // carry it, in every deck that is not archived (ADR 0069). Its
        // tooltip and accessible label ("Study Cards Tagged “verbs”") are
        // set in pages/browser_page.rs.
        [end]
        Gtk.Button study_tag_button {
          visible: false;
          icon-name: "media-playback-start-symbolic";
          action-name: "browser.study-filter-tag";
        }
      }

      // How many cards are chosen, Select All and Cancel (HIG, "Selection
      // mode"); the page cannot be popped then, so Back hides.
      [top]
      $RappelSelectionHeader selection_header {
        visible: false;
      }

      // Deck, tag and state, side by side and as wide as the list under
      // them; on a phone they share the width and their texts end in "…"
      // (ui::dropdown::shrinkable), so they never take more than one line.
      // While a deck is archived a fourth drop-down shows them or not
      // (ADR 0068): beside the others where there is room, each as wide as
      // its text, on a line of its own on a phone (pages/browser_page.rs,
      // `text::filter_layout`, moves it). Hidden while there is no card at
      // all (pages/browser_page.rs).
      [top]
      Adw.Clamp filter_bar {
        maximum-size: 600;

        child: Gtk.Box {
          spacing: 12;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 12;
          margin-end: 12;

          Gtk.Grid filter_grid {
            column-spacing: 6;
            row-spacing: 6;
            column-homogeneous: true;
            hexpand: true;

            Gtk.DropDown deck_filter {
              hexpand: true;
              enable-search: true;
              tooltip-text: _("Deck");

              accessibility {
                label: _("Deck");
              }

              layout {
                column: 0;
                row: 0;
              }
            }

            Gtk.DropDown tag_filter {
              hexpand: true;
              enable-search: true;
              tooltip-text: _("Tag");

              accessibility {
                label: _("Tag");
              }

              layout {
                column: 1;
                row: 0;
              }
            }

            Gtk.DropDown state_filter {
              hexpand: true;
              tooltip-text: _("State");

              model: Gtk.StringList {
                strings [
                  _("Any State"),
                  _("New"),
                  _("Learning"),
                  _("Due"),
                  _("Suspended"),
                ]
              };

              accessibility {
                label: _("State");
              }

              layout {
                column: 2;
                row: 0;
              }
            }

            // Its two entries ("Archived Hidden", "Archived Shown") are set
            // in pages/browser_page.rs.
            Gtk.DropDown archived_filter {
              hexpand: true;
              visible: false;
              tooltip-text: _("Archived Decks");

              accessibility {
                label: _("Archived Decks");
              }

              layout {
                column: 3;
                row: 0;
              }
            }
          }

          Gtk.Label count_label {
            xalign: 1;

            styles [
              "caption",
              "dimmed",
              "numeric",
            ]
          }
        };
      }

      content: Gtk.Stack content_stack {
        Gtk.StackPage {
          name: "empty";

          // Short (a phone held sideways, or the on-screen keyboard up), the
          // empty state is `compact` so its button stays on screen (ADR 0058;
          // `ui::breakpoint`). A bin of its own: the condition is on the
          // room the page leaves it.
          child: Adw.BreakpointBin {
            width-request: 300;
            height-request: 200;

            Adw.Breakpoint empty_short {
              condition ("max-height: 400sp")
            }

            child: Adw.StatusPage empty_page {
              child: Gtk.Button empty_button {
                action-name: "browser.empty-action";
                use-underline: true;
                halign: center;

                styles [
                  "pill",
                  "suggested-action",
                ]
              };
            };
          };
        }

        Gtk.StackPage {
          name: "list";

          // A GtkListView with a model: it only creates rows for what is
          // on screen, so thousands of cards stay smooth (ADR 0013). As on
          // the deck page: clamped to 600 px, and no `rich-list`, because
          // the rows lay themselves out like action rows
          // (data/card_row.blp).
          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            styles [
              "view",
            ]

            child: Adw.ClampScrollable {
              maximum-size: 600;

              child: Gtk.ListView card_list {
                single-click-activate: true;

                accessibility {
                  label: _("Cards");
                }

                styles [
                  "separators",
                ]
              };
            };
          };
        }
      };

      // The actions on the chosen cards (HIG, "Selection mode": an action
      // bar at the bottom), shared with a deck's page.
      [bottom]
      $RappelSelectionBar selection_bar {}
    };
  };
}
