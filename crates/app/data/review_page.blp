using Gtk 4.0;
using Adw 1;

// A study session of a deck or a tag, or a practice of one (ADR 0070: the
// banner shows, nothing is written). Texts are set in pages/review_page.rs;
// the front and back boxes are filled by render/ (ADR 0019), which escapes
// the untrusted card content.
template $RappelReviewPage: Adw.NavigationPage {
  title: C_("page title", "Study");

  // The bin's size request is the window's minimum (data/window.blp);
  // AdwBreakpointBin needs one.
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    // A narrow window stacks the summary's figures, as Statistics does.
    Adw.Breakpoint {
      condition ("max-width: 450sp")

      setters {
        summary_figures.orientation: vertical;
      }
    }

    // A short window (a phone held sideways) keeps the room for the card:
    // the bar's margins shrink. The summary is then
    // `compact` (less spacing) without its icon, so its figures and Back to
    // Deck fit at 360 × 294. A setter can neither add a style class nor
    // unset the icon, so the page does both on `apply` and undoes them on
    // `unapply`. When both breakpoints match, AdwBreakpointBin applies only
    // the last one (AdwBreakpointBin docs), so the figures stay side by
    // side here.
    Adw.Breakpoint short_breakpoint {
      condition ("max-height: 400sp")

      setters {
        bottom_bar.margin-top: 6;
        bottom_bar.margin-bottom: 6;
        summary_box.spacing: 24;
      }
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle window_title {};

        [start]
        Gtk.Button undo_button {
          icon-name: "edit-undo-symbolic";
          action-name: "review.undo";
          tooltip-text: _("Undo Last Answer (Ctrl+Z)");

          accessibility {
            label: _("Undo Last Answer");
          }
        }

        [end]
        Gtk.MenuButton card_menu_button {
          visible: false;
          icon-name: "view-more-symbolic";
          menu-model: card_menu;
          tooltip-text: _("Card Menu");

          accessibility {
            label: _("Card Menu");
          }
        }

        [end]
        Gtk.Button edit_button {
          visible: false;
          icon-name: "document-edit-symbolic";
          action-name: "review.edit";
          tooltip-text: _("Edit Card (E)");

          accessibility {
            label: _("Edit Card");
          }
        }
      }

      // Only in a practice: what makes it unmistakable that the answers
      // schedule nothing. A banner, as the HIG has for a persistent state
      // of the view; no button, since there is nothing to do about it.
      [top]
      Adw.Banner banner {
        title: _("Practice — nothing is rescheduled");
        // The title is plain text (AdwBanner:use-markup defaults to true).
        use-markup: false;
      }

      // No transitions (AdwViewStack's default): the card and the summary
      // replace each other at once; only the answer fades in (the page's
      // reveal animation).
      content: Adw.ViewStack stack {
        Adw.ViewStackPage {
          name: "card";

          // Scrolled to the answer at the reveal when the answer would
          // start below the view (a tall front on a phone; ADR 0058).
          child: Gtk.ScrolledWindow card_scroller {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 700;
              margin-top: 36;
              margin-bottom: 36;
              margin-start: 18;
              margin-end: 18;

              // Focusable, so the keyboard focus can rest here and Space,
              // Enter, 1 and 2 reach the page's shortcuts.
              child: Gtk.Box card_area {
                orientation: vertical;
                spacing: 24;
                focusable: true;
                // A group, not a box's default generic role: GTK exposes no
                // name or description for a generic one (its naming is
                // "prohibited", gtk/gtkatcontext.c), so the card's text set
                // below would not be read (ADR 0051).
                accessible-role: group;

                // Its accessible label is the front's text, and its
                // description the back's once shown (set in the page). The
                // sides' text is larger than body text, the front a little
                // more than the back (`card-front`, `card-back` in
                // data/style.css).
                Gtk.Box front_box {
                  orientation: vertical;

                  styles [
                    "card-front",
                  ]
                }

                // The separator and the back, shown together at the reveal.
                Gtk.Box back_part {
                  orientation: vertical;
                  spacing: 24;
                  visible: false;

                  Gtk.Separator {}

                  Gtk.Box back_box {
                    orientation: vertical;

                    styles [
                      "card-back",
                    ]
                  }
                }

                // Shown when a side is longer than the review page lays out
                // (`render::MAX_SHOWN_BYTES`). Screen readers get the same
                // text with the side (`CUT_NOTE` in the page), so the label
                // itself is hidden from them (a presentation role is not
                // exposed, `gtk_accessible_should_present`), or it would be
                // read twice.
                Gtk.Label cut_note {
                  accessible-role: presentation;
                  label: _("This card is long: only its start is shown. Edit it to see all of it.");
                  visible: false;
                  wrap: true;
                  xalign: 0;

                  styles [
                    "dimmed",
                    "caption",
                  ]
                }
              };
            };
          };
        }

        Adw.ViewStackPage {
          name: "summary";

          child: Adw.StatusPage summary_page {
            // Also in the page (`SUMMARY_ICON`), which takes it off on
            // short windows.
            icon-name: "object-select-symbolic";
            title: _("Session Complete");

            child: Gtk.Box summary_box {
              orientation: vertical;
              spacing: 36;

              // Three figures, laid out like the tiles of Statistics. Their
              // texts are set in the page (`summary_tiles`).
              Adw.Clamp {
                maximum-size: 480;
                tightening-threshold: 480;

                child: Gtk.Box summary_figures {
                  spacing: 12;
                  homogeneous: true;

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 2;

                    styles [
                      "card",
                    ]

                    Gtk.Label cards_value {
                      margin-top: 12;
                      margin-start: 6;
                      margin-end: 6;

                      styles [
                        "title-2",
                        "numeric",
                      ]
                    }

                    Gtk.Label cards_caption {
                      margin-bottom: 12;
                      margin-start: 6;
                      margin-end: 6;
                      wrap: true;
                      justify: center;

                      styles [
                        "caption",
                        "dimmed",
                      ]
                    }
                  }

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 2;

                    styles [
                      "card",
                    ]

                    Gtk.Label passed_value {
                      margin-top: 12;
                      margin-start: 6;
                      margin-end: 6;

                      styles [
                        "title-2",
                        "numeric",
                      ]
                    }

                    Gtk.Label passed_caption {
                      margin-bottom: 12;
                      margin-start: 6;
                      margin-end: 6;
                      wrap: true;
                      justify: center;

                      styles [
                        "caption",
                        "dimmed",
                      ]
                    }
                  }

                  // Not in a practice's summary, which gives the cards
                  // practised and the pass rate (ADR 0070).
                  Gtk.Box time_tile {
                    orientation: vertical;
                    spacing: 2;

                    styles [
                      "card",
                    ]

                    Gtk.Label time_value {
                      margin-top: 12;
                      margin-start: 6;
                      margin-end: 6;
                      wrap: true;
                      justify: center;

                      styles [
                        "title-2",
                        "numeric",
                      ]
                    }

                    Gtk.Label time_caption {
                      margin-bottom: 12;
                      margin-start: 6;
                      margin-end: 6;
                      wrap: true;
                      justify: center;

                      styles [
                        "caption",
                        "dimmed",
                      ]
                    }
                  }
                };
              }

              // Back, and beside it Practice (secondary, after a session
              // only, `practice_button_shown`; ADR 0070). A wrap box puts
              // Practice under Back when a line cannot hold both (a phone
              // with a long translation), so neither is ever cut; it is a
              // group for screen readers (AdwWrapBox docs).
              Adw.WrapBox {
                child-spacing: 12;
                line-spacing: 12;
                align: 0.5;

                Gtk.Button done_button {
                  label: _("_Back to Deck");
                  use-underline: true;
                  action-name: "review.done";

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }

                Gtk.Button practice_button {
                  visible: false;
                  label: _("_Practice");
                  use-underline: true;
                  action-name: "review.practice";
                  tooltip-text: _("Go over the cards again without rescheduling them");

                  styles [
                    "pill",
                  ]
                }
              }
            };
          };
        }
      };

      // Show Answer, then Fail and Pass, in the same place, so the thumb
      // stays where it is. Each button's key is in its tooltip, set in the
      // page (`key_tooltip`; #105), and in its accessible description, which
      // screen readers hear.
      [bottom]
      Adw.Clamp bottom_bar {
        maximum-size: 420;
        tightening-threshold: 420;
        margin-top: 12;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        // Both pages are as tall as each other (`vhomogeneous`).
        child: Adw.ViewStack buttons {
          Adw.ViewStackPage {
            name: "reveal";

            child: Gtk.Button reveal_button {
              label: _("_Show Answer");
              use-underline: true;
              action-name: "review.reveal";

              accessibility {
                description: _("Press Space");
              }

              styles [
                "pill",
                "suggested-action",
                "review-button",
              ]
            };
          }

          Adw.ViewStackPage {
            name: "grade";

            child: Gtk.Box {
              spacing: 12;
              homogeneous: true;

              Gtk.Button fail_button {
                label: _("_Fail");
                use-underline: true;
                action-name: "review.fail";

                accessibility {
                  description: _("Press 1");
                }

                styles [
                  "pill",
                  "review-button",
                ]
              }

              Gtk.Button pass_button {
                label: _("_Pass");
                use-underline: true;
                action-name: "review.pass";

                accessibility {
                  description: _("Press 2 or Space");
                }

                styles [
                  "pill",
                  "suggested-action",
                  "review-button",
                ]
              }
            };
          }
        };
      }
    };
  };
}

// The keys are handled by the page's shortcut controller (`setup_keys`),
// whose callbacks a menu cannot see. The `accel` attribute only shows the
// key in the menu: GtkMenuTrackerItem reads it before asking the action
// muxer (gtk_menu_tracker_item_get_accel). GtkModelButton then also makes
// the key press the item, but in managed scope, so only while the menu is
// open (gtkmodelbutton.c, update_accel), where it acts like a click.
menu card_menu {
  // Edit Card is here too, for the window too narrow for its header button
  // (pages/review_page.rs, `edit_button_shown`).
  section {
    item {
      label: _("_Edit Card");
      accel: "e";
      action: "review.edit";
    }

    item {
      label: _("Card _Information");
      accel: "i";
      action: "review.card-info";
    }
  }

  section {
    item {
      label: _("_Suspend Card");
      accel: "s";
      action: "review.suspend";
    }

    // Leaves the session like Suspend (ADR 0064); disabled when there is
    // no other deck (`dialogs::move_card::offered`).
    item {
      label: _("_Move to Deck…");
      action: "review.move";
    }

    item {
      label: _("_Delete Card…");
      accel: "Delete";
      action: "review.delete";
    }
  }
}
